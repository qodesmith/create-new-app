{
  "name": "create-new-app",
  "version": "8.0.0",
  "description": "Generate a full-stack React application ready for production",
  "type": "module",
  "bin": {
    "create-new-app": "./src/cli/index.ts",
    "cna": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile dist/create-new-app",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "files": ["src", "dist"],
  "keywords": [],
  "homepage": "https://github.com/qodesmith/create-new-app",
  "bugs": {
    "url": "https://github.com/qodesmith/create-new-app/issues",
    "email": "theqodesmith@gmail.com"
  },
  "license": "MIT",
  "author": "Qodesmith <theqodesmith@gmail.com> (https://github.com/qodesmith/create-new-app)",
  "repository": {
    "type": "git",
    "url": "https://github.com/qodesmith/create-new-app"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@qodestack/biome-config": "^2.3.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.18",
    "@hono/arktype-validator": "^2.0.1",
    "@libsql/client": "^0.17.0",
    "@qodestack/utils": "^2.28.0",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-router-devtools": "^1.157.18",
    "@tanstack/router-cli": "^1.157.18",
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-arktype": "^0.1.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
