{
  "name": "create-new-app",
  "version": "8.0.0",
  "description": "Generate a full-stack React application ready for production",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "bin": {
    "create-new-app": "./src/cli/index.ts",
    "cna": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile dist/create-new-app",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "prepublishOnly": "bun run build",
    "checkDeps": "bun run src/utils/checkDeps.ts",
    "updateDeps": "bun run src/utils/updateDeps.ts"
  },
  "files": ["src", "dist"],
  "keywords": [],
  "homepage": "https://github.com/qodesmith/create-new-app",
  "bugs": {
    "url": "https://github.com/qodesmith/create-new-app/issues",
    "email": "theqodesmith@gmail.com"
  },
  "license": "MIT",
  "author": "Qodesmith <theqodesmith@gmail.com> (https://github.com/qodesmith/create-new-app)",
  "repository": {
    "type": "git",
    "url": "https://github.com/qodesmith/create-new-app"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@qodestack/biome-config": "^2.4.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@better-auth/passkey": "^1.6.5",
    "@hono/arktype-validator": "^2.0.1",
    "@libsql/client": "^0.17.2",
    "@qodestack/utils": "^2.29.0",
    "@react-email/components": "^1.0.12",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.1",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-cli": "^1.166.33",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "arktype": "^2.2.0",
    "auth": "^1.6.5",
    "better-auth": "^1.6.5",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-arktype": "^0.1.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-deep-equal": "^3.1.3",
    "hono": "^4.12.14",
    "hono-rate-limiter": "^0.5.3",
    "jotai": "^2.19.1",
    "jotai-family": "^1.0.1",
    "knip": "^6.4.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "open": "^11.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-email": "^6.0.0",
    "resend": "^6.12.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
