{
  "name": "create-new-app",
  "version": "8.0.0",
  "description": "Generate a full-stack React application ready for production",
  "type": "module",
  "workspaces": ["src/projects/*"],
  "bin": {
    "create-new-app": "./bin/cna.js",
    "cna": "./bin/cna.js"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "prepublishOnly": "bun test && bun run check"
  },
  "files": ["bin", "src"],
  "engines": {
    "bun": ">=1.3.13"
  },
  "keywords": [],
  "homepage": "https://github.com/qodesmith/create-new-app",
  "bugs": {
    "url": "https://github.com/qodesmith/create-new-app/issues",
    "email": "theqodesmith@gmail.com"
  },
  "license": "MIT",
  "author": "Qodesmith <theqodesmith@gmail.com> (https://github.com/qodesmith/create-new-app)",
  "repository": {
    "type": "git",
    "url": "https://github.com/qodesmith/create-new-app"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@qodestack/biome-config": "^2.4.13",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
