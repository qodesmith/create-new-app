{
  "name": "create-new-app",
  "version": "8.0.0",
  "description": "Generate a full-stack React application ready for production",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": ["src/projects/*"],
  "bin": {
    "create-new-app": "./src/cli/index.ts",
    "cna": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile dist/create-new-app",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check",
    "check:fix": "biome check --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "prepublishOnly": "bun run build"
  },
  "files": ["src", "dist"],
  "keywords": [],
  "homepage": "https://github.com/qodesmith/create-new-app",
  "bugs": {
    "url": "https://github.com/qodesmith/create-new-app/issues",
    "email": "theqodesmith@gmail.com"
  },
  "license": "MIT",
  "author": "Qodesmith <theqodesmith@gmail.com> (https://github.com/qodesmith/create-new-app)",
  "repository": {
    "type": "git",
    "url": "https://github.com/qodesmith/create-new-app"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@qodestack/biome-config": "^2.4.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/bun": "^1.3.12",
    "only-allow": "^1.2.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
