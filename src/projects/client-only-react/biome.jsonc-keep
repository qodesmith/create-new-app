{
  "root": true,
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@qodestack/biome-config/react"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!dist",
      "!*.lock",
      "!src/routeTree.gen.ts"
    ]
  },
  "overrides": [
    // General rules for client-side code.
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            // Avoid importing process in client code.
            "noProcessGlobal": "off",

            // Inform Biome about how our custom hooks work.
            "useExhaustiveDependencies": {
              "level": "error",
              "fix": "safe",
              "options": {
                "hooks": [{"name": "useStable", "stableResult": true}]
              }
            }
          }
        }
      }
    },

    // Allow Tanstack routes & Shadcn components to export more than components.
    {
      "includes": [
        "src/routes/**/*.tsx",
        "src/components/**/*.tsx",
        "src/components/**/*.ts"
      ],
      "linter": {"rules": {"style": {"useComponentExportOnlyModules": "off"}}}
    }
  ]
}
