# Changing the PORT? Make sure to change the value in
# - litefs.yml => proxy.target
# - Dockerfile, Dockerfile.local
PORT=9001
NODE_ENV=development
SQLITE_PATH={{PROJECT_NAME}}.sqlite
BETTER_AUTH_SECRET={{BETTER_AUTH_SECRET}}

########################
# RESEND EMAIL SERVICE #
########################

# TODO - update these Resend values accordingly

RESEND_API_KEY=your-resend-api-key

# The email you use to sign into your Resend account.
# Emails sent to this address are free. This email will be used during
# development with various routes to avoid charges.
RESEND_ACCOUNT_EMAIL=theqodesmith@gmail.com

# Resend test recipients - simulates different delivery scenarios.
# You can check your Resend dashboard to see these emails.
RESEND_TEST_RECIPIENT=delivered@resend.dev # successful delivery
# RESEND_TEST_RECIPIENT=bounced@resend.dev # email bounce
# RESEND_TEST_RECIPIENT=complained@resend.dev # marked as spam
