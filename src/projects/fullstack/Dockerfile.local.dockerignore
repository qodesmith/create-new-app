# Override used when building with `-f Dockerfile.local` (Docker BuildKit
# picks this up automatically). Mirrors .dockerignore but permits the local
# SQLite DB through, since Dockerfile.local bakes it into the image on
# purpose for local container testing.
*

# --- Allow-list ---
!package.json
!bun.lock
!bunfig.toml
!build.ts
!buildDrizzleStudio.ts
!src
!fullstack.sqlite
!fullstack.sqlite-shm
!fullstack.sqlite-wal

# --- Re-exclude noise ---
**/node_modules
**/dist
**/.tanstack
**/.DS_Store
**/Thumbs.db
**/*.tsbuildinfo
**/*.log

# --- Re-exclude secrets even if placed in src ---
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
