{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun run ./startDev.ts",
    "dev:local": "NODE_ENV=development ALL_CONNECTIONS=true bun --bun run ./startDev.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "bun build client/index.tsx --outdir dist/public --minify --splitting",
    "build:server": "bun build server/index.ts --outdir dist --target bun --minify",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/arktype-validator": "^2.0.1",
    "@libsql/client": "^0.17.0",
    "@qodestack/utils": "^2.28.0",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.157.16",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.17",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-arktype": "^0.1.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "fast-deep-equal": "^3.1.3",
    "hono": "^4.11.6",
    "hono-rate-limiter": "^0.5.3",
    "jotai": "^2.16.2",
    "jotai-family": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.17",
    "@qodestack/biome-config": "^2.3.4",
    "@tanstack/react-router-devtools": "^1.157.16",
    "@tanstack/router-cli": "^1.157.16",
    "@types/bun": "latest",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
