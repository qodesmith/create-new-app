{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun run ./startDev.ts",
    "dev:local": "NODE_ENV=development ALL_CONNECTIONS=true bun --bun run ./startDev.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "bun build client/index.tsx --outdir dist/public --minify --splitting",
    "build:server": "bun build server/index.ts --outdir dist --target bun --minify",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@qodestack/utils": "^1.0.0",
    "@tanstack/react-form": "^0.42.0",
    "@tanstack/react-router": "^1.95.1",
    "arktype": "^2.0.4",
    "better-auth": "^1.1.14",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "jotai": "^2.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@qodestack/biome-config": "^2.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-router-devtools": "^1.95.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
