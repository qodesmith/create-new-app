{
  "name": "create-new-app-template-fullstack",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --bun run ./startDev.ts",
    "dev:all": "NODE_ENV=development ALL_CONNECTIONS=true bun --bun run ./startDev.ts",
    "dev:email": "email dev -d ./src/server/email",
    "docker:local": "NODE_ENV=production docker build -f Dockerfile.local -t {{PROJECT_NAME}}:latest .",
    "typecheck": "bun run typecheck:shared && bun run typecheck:client && bun run typecheck:server && bun run typecheck:root",
    "typecheck:shared": "bunx tsc --noEmit -p src/shared",
    "typecheck:client": "bunx tsc --noEmit -p src/client",
    "typecheck:server": "bunx tsc --noEmit -p src/server",
    "typecheck:root": "bunx tsc --noEmit",
    "deploy": "bun run deploy.ts",
    "db:view": "NODE_ENV=development bun --bun run src/server/db/drizzleStudioLocal.ts",
    "db:init": "NODE_ENV=development bun --bun run initDevDb.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.18",
    "@better-auth/passkey": "^1.6.18",
    "@hono/arktype-validator": "^2.0.1",
    "@libsql/client": "^0.17.3",
    "@qodestack/utils": "^3.0.0",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "arktype": "^2.2.0",
    "better-auth": "^1.6.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-arktype": "^0.1.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "jotai": "^2.20.1",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.0.2",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@qodestack/biome-config": "^2.4.14",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/node": "^4.3.1",
    "@tailwindcss/oxide": "^4.3.1",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "auth": "^1.6.18",
    "happy-dom": "^20.10.6",
    "knip": "^6.16.1",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "react-email": "^6.6.0",
    "typescript": "^6.0.3"
  }
}
