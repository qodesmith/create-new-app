{
  "name": "create-new-app-template-fullstack",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --bun run ./startDev.ts",
    "dev:all": "NODE_ENV=development ALL_CONNECTIONS=true bun --bun run ./startDev.ts",
    "dev:email": "email dev -d ./src/server/email",
    "docker:local": "NODE_ENV=production docker build -f Dockerfile.local -t {{PROJECT_NAME}}:latest .",
    "typecheck": "bun run typecheck:shared && bun run typecheck:client && bun run typecheck:server && bun run typecheck:root",
    "typecheck:shared": "bunx tsc --noEmit -p src/shared",
    "typecheck:client": "bunx tsc --noEmit -p src/client",
    "typecheck:server": "bunx tsc --noEmit -p src/server",
    "typecheck:root": "bunx tsc --noEmit",
    "deploy": "bun run deploy.ts",
    "db:view": "NODE_ENV=development bun --bun run src/server/db/drizzleStudioLocal.ts",
    "db:init": "NODE_ENV=development bun --bun run initDevDb.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.10",
    "@hono/arktype-validator": "^2.0.1",
    "@libsql/client": "^0.17.3",
    "@qodestack/utils": "^2.29.0",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "arktype": "^2.2.0",
    "better-auth": "^1.6.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-arktype": "^0.1.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-deep-equal": "^3.1.3",
    "hono": "^4.12.18",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@qodestack/biome-config": "^2.4.13",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-cli": "^1.166.43",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "auth": "^1.6.10",
    "knip": "^6.12.2",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "react-email": "^6.1.1",
    "typescript": "^6.0.3"
  }
}
