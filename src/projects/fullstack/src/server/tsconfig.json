{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/shared/*": ["../shared/*"],
      "@/server/*": ["./*"],

      // Needed because shared/types.d.ts (re-exported via @/shared/*) imports
      // FileRouteTypes from ../client/routeTree.gen, which drags every client
      // route and its transitive component imports into the program; those
      // files use @/client/* internally and need to resolve from this
      // tsconfig's context. Biome prevents actually importing client code
      // from the server.
      "@/client/*": ["../client/*"]
    }
  },
  "include": ["./**/*"]
}
