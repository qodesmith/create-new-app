{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Server .tsx files (email templates) get reached through the import
    // chain (types.d.ts → server imports), so JSX must be configured here.
    "jsx": "react-jsx",
    "paths": {
      // Needed because shared/types.d.ts imports from ../server/*, which
      // drags server files into the program; those files use @/server/*
      // internally and need to resolve from this tsconfig's context.
      "@/server/*": ["../server/*"],

      // Server files reached via the import chain also use @/shared/*.
      "@/shared/*": ["./*"],

      // Needed because shared/types.d.ts imports FileRouteTypes from
      // ../client/routeTree.gen, which drags every client route (and their
      // transitive component imports) into the program; those files use
      // @/client/* internally and need to resolve from this tsconfig's context.
      "@/client/*": ["../client/*"]
    }
  },
  "include": ["./**/*"]
}
